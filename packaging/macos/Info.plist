<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>minutes</string>
	<key>CFBundleIdentifier</key>
	<string>com.punkjazz.minutes</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>minutes</string>
	<key>CFBundleDisplayName</key>
	<string>minutes</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.3.0</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.4</string>
	<!-- Menu bar only. No dock icon, no window on launch. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>minutes records your microphone so it can transcribe the meeting on this Mac.</string>
	<!-- Used by the Core Audio process tap since v0.2. There is no public API
	     to query or request this permission, so it has to be typed in by hand
	     and the app has to survive being granted nothing and recording
	     silence. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>minutes records what your Mac is playing so it can transcribe what the other people in the meeting say. It listens to the sound on its way out and changes nothing, so you keep hearing the meeting normally.</string>
</dict>
</plist>
